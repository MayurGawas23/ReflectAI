rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User interactions: strictly isolated to the authenticated owner
    // Critical privacy constraint: Even admins cannot read personal reflections
    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Role-Based Access Control: Admin registry
    // Strictly restricted to mayur.gawas4work@gmail.com
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.token.email == 'mayur.gawas4work@gmail.com';
      allow write: if request.auth != null && request.auth.uid == adminId && request.auth.token.email == 'mayur.gawas4work@gmail.com';
    }

    // Aggregated telemetry and system metrics (strictly for mayur.gawas4work@gmail.com)
    match /system_telemetry/{metricId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'mayur.gawas4work@gmail.com';
    }

    // Telemetry logs entries subcollection
    match /system_telemetry/logs/entries/{entryId} {
      allow read: if request.auth != null && request.auth.token.email == 'mayur.gawas4work@gmail.com';
      allow write: if request.auth != null;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
